# BlenderMCP Environment Configuration
# Copy this file to .env and fill in your values.
# ---------------------------------------------------------------------------
# All variables below are documented. Uncomment to override the defaults that
# are baked into src/blender_mcp/constants.py.

# ===== Blender Connection =================================================
# Both server and addon must agree on these values.
BLENDER_HOST=localhost
BLENDER_PORT=9876

# ===== Socket transport tuning ============================================
# Per-operation socket timeout (seconds). Bump this if Blender is busy.
BLENDER_SOCKET_TIMEOUT=15

# How many times the MCP server will retry the initial TCP handshake before
# giving up. Useful when starting Blender and the MCP server at the same time.
BLENDER_CONNECT_ATTEMPTS=3

# How many times the server retries a single command after a transient error
# (timeout, broken pipe, connection reset).
BLENDER_COMMAND_ATTEMPTS=3

# Linear backoff between retries, in seconds. Final wait = backoff * attempt.
BLENDER_RETRY_BACKOFF=1.0

# ===== Logging ============================================================
BLENDER_MCP_LOG_LEVEL=INFO
BLENDER_MCP_LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
BLENDER_MCP_LOG_HANDLER=console
# BLENDER_MCP_LOG_FILE=blender_mcp.log  # Uncomment if using file handler

# ===== API keys (optional - can also be set in Blender UI) ===============
# Get your free trial key from https://hyper3d.ai/
# RODIN_API_KEY=your_hyper3d_api_key_here

# Get your API key from https://sketchfab.com/settings/password
# SKETCHFAB_API_KEY=your_sketchfab_api_key_here

# ===== Cache Settings ====================================================
# BLENDER_MCP_CACHE_DIR=~/.blender_mcp_cache
# BLENDER_MCP_CACHE_MAX_SIZE_MB=1000

# ===== Security & Limits =================================================
# Hard timeout for execute_blender_code, in seconds.
# BLENDER_MCP_CODE_TIMEOUT=5

# Per-connection rate limit.
# BLENDER_MCP_RATE_LIMIT_CALLS=10
# BLENDER_MCP_RATE_LIMIT_WINDOW=60

# === NEW in this fork =====================================================
# Shared secret. When set, the MCP server attaches it as the
# `X-BlenderMCP-Token` header on every command; the addon rejects calls
# without it. Leave UNSET on a trusted single-user host.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# BLENDER_MCP_TOKEN=

# Maximum size of a single command payload (bytes). Caps memory use if a
# malicious or buggy peer sends an enormous blob.
# BLENDER_MCP_MAX_PAYLOAD_BYTES=4194304  # 4 MiB

# When set to "1", allows binding to a non-loopback address (0.0.0.0).
# Off by default for safety — Blender is not designed for public access.
# BLENDER_MCP_ALLOW_PUBLIC_BIND=0

